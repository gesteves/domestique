{
  "name": "domestique",
  "version": "1.0.0",
  "description": "Fitness MCP server integrating Intervals.icu, Whoop, and TrainerRoad",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && cp -r src/prompts dist/prompts",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "whoop:auth": "node dist/scripts/whoop-oauth.js",
    "whoop:auth:dev": "tsx src/scripts/whoop-oauth.ts",
    "whoop:backfill": "node dist/scripts/backfill-whoop-strain.js",
    "whoop:backfill:dev": "tsx src/scripts/backfill-whoop-strain.ts",
    "test:clients": "node dist/scripts/test-clients.js"
  },
  "keywords": [
    "mcp",
    "fitness",
    "intervals.icu",
    "whoop",
    "trainerroad"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "@bugsnag/js": "^9.1.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "chrono-node": "^2.10.3",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "express": "^5.3.0",
    "node-ical": "^0.27.6",
    "redis": "^6.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.10",
    "@vitest/coverage-v8": "^5.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
