# MCP Server Authentication
MCP_AUTH_TOKEN=your-secret-token-here

# Optional: extra hostnames allowed in the Origin header on /mcp (localhost is always allowed)
# MCP_ALLOWED_ORIGINS=example.com,app.example.com

# Intervals.icu API (HTTP Basic Auth)
INTERVALS_API_KEY=your-intervals-api-key
INTERVALS_ATHLETE_ID=your-athlete-id

# Whoop API (OAuth 2.0)
WHOOP_CLIENT_ID=your-whoop-client-id
WHOOP_CLIENT_SECRET=your-whoop-client-secret

# TrainerRoad (iCalendar Feed URL)
TRAINERROAD_CALENDAR_URL=https://www.trainerroad.com/calendar/ical/your-private-token

# Google APIs (Weather, Air Quality, Pollen, Elevation, Geocoding, Time Zone)
# Forecast locations come from the athlete's Intervals.icu weather config, or
# any place geocoded from the `location` argument of get_weather_forecast.
# Enable all six APIs on your Google Cloud project:
# https://developers.google.com/maps/documentation/weather/get-api-key
# https://developers.google.com/maps/documentation/air-quality/get-api-key
# https://developers.google.com/maps/documentation/pollen/get-api-key
# https://developers.google.com/maps/documentation/elevation/cloud-setup
# https://developers.google.com/maps/documentation/geocoding/get-api-key
# https://developers.google.com/maps/documentation/timezone/get-api-key
GOOGLE_API_KEY=your-google-api-key

# Server Configuration
PORT=3000

# Logging (Optional): debug | info (default) | warn | error
# LOG_LEVEL=info

# Error Reporting (Optional)
# Set to enable Bugsnag error reporting (including upstream API failures)
BUGSNAG_API_KEY=your-bugsnag-api-key

# Anthropic API
# Required for create_workout / update_workout on cycling and running: the
# plain-language `structure` is converted to Intervals.icu workout-doc syntax
# by Claude. Also enables, when set:
#   - Categorization of TrainerRoad annotations into Sick/Injured/Holiday/Note
#     (cached in Redis when configured). Without this key, all TR annotations
#     carry category 'Note' and dedup against Intervals.icu uses title matching.
#   - Triathlon race priority (A/B/C) extraction from the TR race description.
#   - Token counting in tool responses (development mode only).
ANTHROPIC_API_KEY=your-anthropic-api-key

# Override the Claude model used by the annotation and race-priority
# classifiers. Defaults to claude-haiku-4-5 if unset.
ANTHROPIC_CLASSIFIER_MODEL=

# Override the Claude model used by the create_workout / update_workout
# structure converter. Defaults to claude-sonnet-4-6 if unset.
ANTHROPIC_WORKOUT_MODEL=

# Override the Claude model used for dev-only token counting.
# Defaults to claude-haiku-4-5 if unset.
ANTHROPIC_TOKEN_COUNTER_MODEL=

# MCP Request Logging (Optional)
# When set to "true", logs each incoming JSON-RPC request to /mcp including
# the method, tool name (for tools/call), and any client-supplied _meta field.
# Useful for inspecting what different MCP clients (Claude, ChatGPT, etc.)
# send in _meta.
LOG_MCP_REQUESTS=false
